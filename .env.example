# ── Revenue Desk — Environment Variables ──
# Copy this to .env

# LLM Provider: 'gemini' (Free), 'mock' (Free, no keys needed), or 'anthropic'
LLM_PROVIDER=mock

# 1. Google Gemini API Key (100% FREE at https://aistudio.google.com/ - no credit card needed)
GEMINI_API_KEY=

# 2. Anthropic API Key (Optional)
ANTHROPIC_API_KEY=

# Database path (optional, defaults to data/revenue_desk.db)
DB_PATH=data/revenue_desk.db

# ── Switch Configuration (For Nov 4 Hackathon Bridge) ──
SWITCH_HOMESERVER=
SWITCH_ROOM_ID=
ANALYST_USER_ID=@analyst:server
ANALYST_PASSWORD=analyst-password
REVIEWER_USER_ID=@reviewer:server
REVIEWER_PASSWORD=reviewer-password
