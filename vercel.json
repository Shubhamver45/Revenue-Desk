{
  "functions": {
    "api/**/*.py": {
      "includeFiles": "{dist/**,src/**,seed/**,switch/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__route=$1"
    },
    {
      "source": "/api",
      "destination": "/api/index.py?__route=state"
    },
    {
      "source": "/blog",
      "destination": "/dist/blog.html"
    },
    {
      "source": "/blog.html",
      "destination": "/dist/blog.html"
    },
    {
      "source": "/landing",
      "destination": "/dist/landing.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dist/index.html"
    },
    {
      "source": "/investigations",
      "destination": "/dist/index.html"
    },
    {
      "source": "/room",
      "destination": "/dist/index.html"
    },
    {
      "source": "/approvals",
      "destination": "/dist/index.html"
    },
    {
      "source": "/audit",
      "destination": "/dist/index.html"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/dist/assets/$1"
    },
    {
      "source": "/",
      "destination": "/dist/index.html"
    }
  ]
}
