{
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.py": {
      "includeFiles": "{dist/**,src/**,seed/**,switch/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__route=$1"
    },
    {
      "source": "/api",
      "destination": "/api/index.py?__route=state"
    },
    {
      "source": "/blog",
      "destination": "/blog.html"
    },
    {
      "source": "/blog.html",
      "destination": "/blog.html"
    },
    {
      "source": "/landing",
      "destination": "/landing.html"
    },
    {
      "source": "/landing.html",
      "destination": "/landing.html"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
