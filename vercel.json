{
  "functions": {
    "api/**/*.py": {
      "includeFiles": "{src/**,seed/**,switch/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/landing",
      "destination": "/dist/landing.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dist/index.html"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/dist/assets/$1"
    },
    {
      "source": "/",
      "destination": "/dist/index.html"
    }
  ]
}
